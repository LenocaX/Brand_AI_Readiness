# Canopy — Environment Configuration

# Database Configuration
# Primary: PostgreSQL (production / staging)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/canopy_db
# Fallback: Leave empty to automatically use local SQLite (canopy.db)

# Authentication & Session Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production-2026
SESSION_COOKIE_SECURE=false

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Optional Search / External API integrations
LLM_API_KEY=
